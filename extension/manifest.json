{
  "manifest_version": 3,
  "name": "w3bm@p — Web Discovery",
  "version": "0.3.1",
  "minimum_chrome_version": "116",
  "description": "Discover page technologies and relationships, optionally enrich them with your PHP connector, and explore a local graph.",
  "permissions": ["activeTab", "scripting", "storage", "favicon"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Detect technologies with w3bm@p",
    "default_popup": "popup/index.html",
    "default_icon": { "16": "assets/icon-16.png", "32": "assets/icon-32.png" }
  },
  "options_ui": { "page": "options/index.html", "open_in_tab": true },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
