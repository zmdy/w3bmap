# Run install.php to generate the private .env outside the public document root.
# This reference file is not the loaded configuration. See docs/connector.md.
# Manual key generation: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
W3BMAP_API_KEY=
W3BMAP_ALLOWED_DOMAINS=example.com,www.example.com
W3BMAP_ALLOW_LOCAL_HTTP=0
W3BMAP_ENABLE_ENVIRONMENT=0
W3BMAP_RATE_LIMIT=30
W3BMAP_TIMEOUT=10
W3BMAP_MAX_BYTES=1048576
# Optional: writable directory outside the document root.
# W3BMAP_RATE_DIRECTORY=/var/lib/w3bmap/rate
